# ---- Server ----
ENV=dev                         # dev | prod  (prod REQUIRES SERVER_SECRET and disables /v1/dev/*)
SERVER_SECRET=                  # openssl rand -base64 48  (signs widget + agent tokens)
ADMIN_API_KEY=change-me-admin   # protects /v1/admin/*; leave empty to disable
DATABASE_URL=sqlite+aiosqlite:///./supportpilot.db   # prod: postgresql+asyncpg://user:pass@host/db

# ---- LLM ----
LLM_PROVIDER=anthropic          # anthropic | demo (keyword stand-in, no key needed)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5 # cheaper/faster: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_EFFORT=medium

# ---- Tenant "acme" (demo) secrets: referenced by name from tenants/acme/tenant.yaml ----
ACME_USER_TOKEN_SECRET=dev-only-shared-secret-change-me-32chars
ACME_AGENT_KEY_SAM=sam-demo-key
ACME_AGENT_KEY_JO=jo-demo-key
# ACME_JIRA_EMAIL=
# ACME_JIRA_TOKEN=
# ACME_HANDOFF_WEBHOOK=
ANTHROPIC_FALLBACK_MODEL=              # optional: used on overload/timeouts of the primary (e.g. claude-sonnet-5-5)
REDIS_URL=                              # set when running >1 replica (cross-pod live delivery + shared rate limits)
LLM_MAX_CONCURRENCY=64                  # concurrent model calls per replica
LOG_FORMAT=text                         # json in production
METRICS_TOKEN=                          # if set, /metrics requires 'Authorization: Bearer <token>'
