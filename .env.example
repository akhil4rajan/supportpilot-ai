# ---- Server ----
ENV=dev                         # dev | prod  (prod REQUIRES SERVER_SECRET and disables /v1/dev/*)
SERVER_SECRET=                  # openssl rand -base64 48  (signs widget + agent tokens)
ADMIN_API_KEY=change-me-admin   # protects /v1/admin/*; leave empty to disable
DATABASE_URL=sqlite+aiosqlite:///./supportpilot.db   # prod: postgresql+asyncpg://user:pass@host/db

# ---- LLM ----
# Pick ONE provider: anthropic | openai | gemini | meta | groq | together | fireworks | mistral | deepseek |
#                    openrouter | ollama | vllm | openai_compatible | demo (keyword stand-in, no key needed)
LLM_PROVIDER=anthropic
LLM_MODEL=                      # the provider's model id (required except for anthropic)
# LLM_BASE_URL=                 # override the provider's endpoint (Azure, a proxy, your own server)
# LLM_API_KEY=                  # generic key; or use the provider's own variable below
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=  GEMINI_API_KEY=  LLAMA_API_KEY=  GROQ_API_KEY=  TOGETHER_API_KEY=  MISTRAL_API_KEY=  OPENROUTER_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5 # default model when LLM_PROVIDER=anthropic
ANTHROPIC_EFFORT=medium
# Optional fallback on overload/timeouts; may be a DIFFERENT provider than the primary:
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=

# ---- Tenant "acme" (demo) secrets: referenced by name from tenants/acme/tenant.yaml ----
ACME_USER_TOKEN_SECRET=dev-only-shared-secret-change-me-32chars
ACME_AGENT_KEY_SAM=sam-demo-key
ACME_AGENT_KEY_JO=jo-demo-key
# ---- Tenant "wattlebay" (fictional Sydney hospital demo) ----
WATTLEBAY_USER_TOKEN_SECRET=dev-only-wattlebay-secret-change-me-32chars
WATTLEBAY_AGENT_KEY_SAM=wb-sam-demo-key
WATTLEBAY_AGENT_KEY_JO=wb-jo-demo-key
# ACME_JIRA_EMAIL=
# ACME_JIRA_TOKEN=
# ACME_HANDOFF_WEBHOOK=
REDIS_URL=                              # set when running >1 replica (cross-pod live delivery + shared rate limits)
LLM_MAX_CONCURRENCY=64                  # concurrent model calls per replica
LOG_FORMAT=text                         # json in production
METRICS_TOKEN=                          # if set, /metrics requires 'Authorization: Bearer <token>'
